{
  "nftables": [
    { "add": { "table": { "family": "inet", "name": "ssh_access" } } },
    {
      "add": {
        "set": {
          "family": "inet",
          "table": "ssh_access",
          "name": "ssh_clients_v4",
          "type": "ipv4_addr",
          "flags": ["timeout"],
          "timeout": 300
        }
      }
    },
    {
      "add": {
        "set": {
          "family": "inet",
          "table": "ssh_access",
          "name": "ssh_clients_v6",
          "type": "ipv6_addr",
          "flags": ["timeout"],
          "timeout": 300
        }
      }
    },
    {
      "add": {
        "chain": {
          "family": "inet",
          "table": "ssh_access",
          "name": "input",
          "type": "filter",
          "hook": "input",
          "prio": 0,
          "policy": "accept"
        }
      }
    },
    {
      "add": {
        "chain": {
          "family": "inet",
          "table": "ssh_access",
          "name": "ssh_policy"
        }
      }
    },
    { "flush": { "chain": { "family": "inet", "table": "ssh_access", "name": "input" } } },
    { "flush": { "chain": { "family": "inet", "table": "ssh_access", "name": "ssh_policy" } } },
    {
      "add": {
        "rule": {
          "family": "inet",
          "table": "ssh_access",
          "chain": "input",
          "comment": "ssh-allow policy hook",
          "expr": [{ "jump": { "target": "ssh_policy" } }]
        }
      }
    },
    {
      "add": {
        "rule": {
          "family": "inet",
          "table": "ssh_access",
          "chain": "ssh_policy",
          "comment": "IPv6 SSH reject",
          "expr": [
            { "match": { "op": "==", "left": { "meta": { "key": "nfproto" } }, "right": "ipv6" } },
            { "match": { "op": "==", "left": { "payload": { "protocol": "tcp", "field": "dport" } }, "right": 22 } },
            { "reject": { "type": "icmpv6", "expr": "port-unreachable" } }
          ]
        }
      }
    },
    {
      "add": {
        "rule": {
          "family": "inet",
          "table": "ssh_access",
          "chain": "ssh_policy",
          "expr": [
            { "match": { "op": "in", "left": { "ct": { "key": "state" } }, "right": { "set": ["established", "related"] } } },
            { "accept": null }
          ]
        }
      }
    },
    {
      "add": {
        "rule": {
          "family": "inet",
          "table": "ssh_access",
          "chain": "ssh_policy",
          "expr": [
            { "match": { "op": "==", "left": { "meta": { "key": "iifname" } }, "right": "lo" } },
            { "accept": null }
          ]
        }
      }
    },
    {
      "add": {
        "rule": {
          "family": "inet",
          "table": "ssh_access",
          "chain": "ssh_policy",
          "expr": [
            { "match": { "op": "==", "left": { "payload": { "protocol": "tcp", "field": "dport" } }, "right": 22 } },
            { "match": { "op": "==", "left": { "payload": { "protocol": "ip", "field": "saddr" } }, "right": "@ssh_clients_v4" } },
            { "accept": null }
          ]
        }
      }
    },
    {
      "add": {
        "rule": {
          "family": "inet",
          "table": "ssh_access",
          "chain": "ssh_policy",
          "expr": [
            { "match": { "op": "==", "left": { "payload": { "protocol": "tcp", "field": "dport" } }, "right": 22 } },
            { "match": { "op": "==", "left": { "meta": { "key": "nfproto" } }, "right": "ipv4" } },
            { "reject": { "type": "icmp", "expr": "port-unreachable" } }
          ]
        }
      }
    },
    {
      "add": {
        "rule": {
          "family": "inet",
          "table": "ssh_access",
          "chain": "ssh_policy",
          "comment": "IPv6 SSH allowlist",
          "expr": [
            { "match": { "op": "==", "left": { "payload": { "protocol": "tcp", "field": "dport" } }, "right": 22 } },
            { "match": { "op": "==", "left": { "payload": { "protocol": "ip6", "field": "saddr" } }, "right": "@ssh_clients_v6" } },
            { "accept": null }
          ]
        }
      }
    }
  ]
}
