[Unit]
Description=SSH nftables allowlist service
After=nftables.service ssh.service sshd.service dropbear.service

[Service]
User=daemon
ExecStart=/usr/local/bin/ssh-allow --timeout 300 --socket /run/ssh-allow/ssh-allow.sock
ExecStartPre=/usr/bin/rm -f /run/ssh-allow/ssh-allow.sock
RuntimeDirectory=ssh-allow
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
